<Window x:Class="AntigravityChinese.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity App 汉化" Height="760" Width="980" MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="#15233B" FontSize="14" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#DCE3EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#1269F2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#E2E8F2" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
        </Style>
    </Window.Resources>
    <Grid Margin="32,28,32,22" Background="#F4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" Background="#1269F2" CornerRadius="14" VerticalAlignment="Top">
                <TextBlock Text="文" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Antigravity App 汉化" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="离线完成，随时恢复原版。" Foreground="#64748B" Margin="0,7,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="#E6F5EE" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="●  离线工具" Foreground="#14784B" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="Antigravity 安装位置" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="DetectionText" Text="正在检测…" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#F8FAFD" CornerRadius="8" BorderBrush="#DCE3EE" BorderThickness="1" Margin="0,0,10,0">
                        <TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0" Padding="12,13" VerticalContentAlignment="Center"
                                 ToolTip="选择 Antigravity App 安装目录，也可以直接粘贴路径。" />
                    </Border>
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="选择目录" Click="Browse_Click" Margin="0,0,10,0" />
                    <Button x:Name="DetectButton" Grid.Column="2" Content="自动检测" Click="Detect_Click" />
                </Grid>
                <TextBlock x:Name="CompatibilityText" Grid.Row="2" Text="无需安装其他程序，也无需填写 API 密钥。" Foreground="#64748B" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="内置汉化包" FontSize="12" Foreground="#64748B" />
                    <TextBlock x:Name="PackageText" Text="加载中" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="CoverageText" Foreground="#64748B" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Column="2">
                <StackPanel>
                    <TextBlock Text="当前状态" FontSize="12" Foreground="#64748B" />
                    <TextBlock x:Name="StateText" Text="等待检测" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="SafetyText" Text="汉化前自动备份，恢复时核对当前文件。" Foreground="#64748B" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock x:Name="StageText" Text="准备就绪" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PercentText" Text="" Foreground="#1269F2" HorizontalAlignment="Right" />
                </DockPanel>
                <ProgressBar x:Name="WorkBar" Grid.Row="1" Height="5" Maximum="100" Foreground="#1269F2" Background="#ECF1F8" BorderThickness="0" Margin="0,16,0,14" />
                <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0" Background="Transparent"
                         Foreground="#64748B" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActionHint" Text="请先从托盘退出 App，再执行汉化。" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0" />
                    <Button x:Name="RestoreButton" Grid.Column="1" Content="恢复原版" IsEnabled="False" Click="Restore_Click" Margin="0,0,10,0" />
                    <Button x:Name="ApplyButton" Grid.Column="2" Content="开始汉化" IsEnabled="False" Click="Apply_Click" Background="#1269F2" Foreground="White" BorderBrush="#1269F2" Padding="28,12" />
                </Grid>
            </Grid>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="Antigravity App 汉化工具 · 社区作品" Foreground="#94A3B8" FontSize="11" />
            <TextBlock x:Name="ToolVersionText" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
